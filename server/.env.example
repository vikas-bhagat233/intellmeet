# Server environment example for IntellMeet
# Copy to `.env` and fill values before running in production

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/intellmeet?retryWrites=true&w=majority
JWT_SECRET=change_this_secret
CLIENT_URL=https://your-client-domain.com

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional provider keys
OPENAI_API_KEY=

NODE_ENV=production
